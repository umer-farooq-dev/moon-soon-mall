{% doc %}
  MoonSoon "Pair it with" mini card. Product comes from the "Pair it with" metafield,
  falling back to the block's product. Hidden when neither is set.
{% enddoc %}
{%- liquid
  assign p = closest.product.metafields.custom.pair_with.value | default: block.settings.product
  if p.id == closest.product.id
    assign p = nil
  endif
-%}
{%- if p != blank -%}
  {%- assign v = p.selected_or_first_available_variant -%}
  <div class="ms-pair" {{ block.shopify_attributes }}>
    {%- if block.settings.heading != blank -%}
      <p class="ms-pair__heading">{{ block.settings.heading }}</p>
    {%- endif -%}
    <div class="ms-pair__card">
      <a href="{{ p.url }}" class="ms-pair__img">
        {%- if p.featured_image -%}
          {{ p.featured_image | image_url: width: 200 | image_tag: loading: 'lazy', alt: p.featured_image.alt | default: p.title }}
        {%- endif -%}
      </a>
      <div class="ms-pair__info">
        <a href="{{ p.url }}" class="ms-pair__title">{{ p.title }}</a>
        <p class="ms-pair__price">
          <strong>{{ v.price | money_without_trailing_zeros }}</strong>
          {%- if v.compare_at_price > v.price -%}<s>{{ v.compare_at_price | money_without_trailing_zeros }}</s>{%- endif -%}
        </p>
        {%- if v.available -%}
          <button type="button" class="button ms-pair__btn" data-ms-add="{{ v.id }}">{{ block.settings.button }}</button>
        {%- endif -%}
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "MoonSoon pair it with",
  "tag": null,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Pair It With" },
    { "type": "text", "id": "button", "label": "Button text", "default": "Add to cart" },
    {
      "type": "product",
      "id": "product",
      "label": "Fallback product",
      "info": "Per product: Metafields → Pair it with"
    }
  ],
  "presets": [
    {
      "name": "MoonSoon pair it with"
    }
  ]
}
{% endschema %}
