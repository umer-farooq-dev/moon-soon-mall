{% doc %}
  MoonSoon benefit pills with a tick, from the product's "Benefit pills" metafield.
{% enddoc %}
{%- liquid
  assign list = closest.product.metafields.custom.benefits.value
  if list == blank and block.settings.from_description
    assign items = closest.product.description | split: '<li>'
    assign list = ''
    for it in items offset: 1 limit: block.settings.max
      assign t = it | split: '</li>' | first | strip_html | strip
      assign list = list | append: t | append: '|~|'
    endfor
    assign list = list | split: '|~|'
  endif
-%}
{%- if list != blank -%}
  <ul class="ms-pdp-benefits" {{ block.shopify_attributes }}>
    {%- for b in list -%}
      <li>
        <svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="9" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="m6 10.2 2.6 2.6L14 7.4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <span>{{ b }}</span>
      </li>
    {%- endfor -%}
  </ul>
{%- endif -%}

{% schema %}
{
  "name": "MoonSoon benefit pills",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "Products → product → Metafields → Benefit pills (3 short lines work best)"
    },
    { "type": "checkbox", "id": "from_description", "label": "No pills set? Use the bullet points of the description", "default": true },
    { "type": "range", "id": "max", "label": "Max pills", "min": 1, "max": 6, "step": 1, "default": 3 }
  ],
  "presets": [
    {
      "name": "MoonSoon benefit pills"
    }
  ]
}
{% endschema %}
