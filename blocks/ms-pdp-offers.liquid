{% doc %}
  MoonSoon quantity offers (1 Pack / 2 Pack / 3 Pack). Choosing a box sets the Add to cart quantity.
  The saving itself must come from a Shopify automatic discount with the same rule
  (e.g. "Buy 2, get 5% off") — this block only shows it.
{% enddoc %}
{%- liquid
  assign product = closest.product
  assign variant = product.selected_or_first_available_variant
  assign s = block.settings
-%}
<fieldset class="ms-offers" data-ms-offers {{ block.shopify_attributes }}>
  {%- if s.heading != blank -%}
    <legend class="ms-offers__heading">{{ s.heading }}</legend>
  {%- endif -%}
  {%- for i in (1..3) -%}
    {%- liquid
      assign qty_key = 'qty_' | append: i
      assign qty = s[qty_key]
      if qty == 0
        continue
      endif
      assign title_key = 'title_' | append: i
      assign tag_key = 'tag_' | append: i
      assign pct_key = 'save_' | append: i
      assign perks_key = 'perks_' | append: i
      assign pct = s[pct_key]
      assign full = variant.price | times: qty
      assign keep = 100 | minus: pct
      assign price = full | times: keep | divided_by: 100
      assign was = variant.compare_at_price | default: variant.price | times: qty
      assign perks = s[perks_key] | newline_to_br | split: '<br />'
    -%}
    <label class="ms-offer-box{% if pct > 0 %} ms-offer-box--deal{% endif %}">
      {%- if s[tag_key] != blank -%}
        <span class="ms-offer-box__tag">
          {{- s[tag_key] -}}
          {%- if pct > 0 -%}<em>{{ s.save_text | replace: '[percent]', pct }}</em>{%- endif -%}
        </span>
      {%- endif -%}
      <span class="ms-offer-box__row">
        <input type="radio" name="ms-offer-{{ block.id }}" value="{{ qty }}" {% if forloop.first %}checked{% endif %}>
        <span class="ms-offer-box__title">{{ s[title_key] | default: qty }}</span>
        <span class="ms-offer-box__price">
          <strong>{{ price | money_without_trailing_zeros }}</strong>
          {%- if was > price -%}<s>{{ was | money_without_trailing_zeros }}</s>{%- endif -%}
        </span>
      </span>
      {%- if s[perks_key] != blank -%}
        <ul class="ms-offer-box__perks">
          {%- for perk in perks -%}
            {%- assign t = perk | strip -%}
            {%- if t != blank -%}<li>{{ t }}</li>{%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </label>
  {%- endfor -%}
</fieldset>

{% schema %}
{
  "name": "MoonSoon quantity offers",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "Create the matching automatic discount in Shopify admin → Discounts (e.g. Amount off products, minimum quantity 2, 5%). Set quantity to 0 to hide an offer."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "text",
      "id": "save_text",
      "label": "Save label",
      "default": "Save [percent]%"
    },
    {
      "type": "header",
      "content": "Offer 1"
    },
    { "type": "range", "id": "qty_1", "label": "Quantity", "min": 0, "max": 10, "step": 1, "default": 1 },
    { "type": "text", "id": "title_1", "label": "Title", "default": "1 Pack" },
    { "type": "text", "id": "tag_1", "label": "Tag", "default": "Most Popular" },
    { "type": "range", "id": "save_1", "label": "Save %", "min": 0, "max": 50, "step": 1, "default": 0 },
    { "type": "textarea", "id": "perks_1", "label": "Perks (one per line)", "default": "Cash on Delivery\nEasy 7-day exchange" },
    {
      "type": "header",
      "content": "Offer 2"
    },
    { "type": "range", "id": "qty_2", "label": "Quantity", "min": 0, "max": 10, "step": 1, "default": 2 },
    { "type": "text", "id": "title_2", "label": "Title", "default": "2 Pack" },
    { "type": "text", "id": "tag_2", "label": "Tag", "default": "Best Deal" },
    { "type": "range", "id": "save_2", "label": "Save %", "min": 0, "max": 50, "step": 1, "default": 5 },
    { "type": "textarea", "id": "perks_2", "label": "Perks (one per line)", "default": "Cash on Delivery\nEasy 7-day exchange\nBest value" },
    {
      "type": "header",
      "content": "Offer 3"
    },
    { "type": "range", "id": "qty_3", "label": "Quantity", "min": 0, "max": 10, "step": 1, "default": 0 },
    { "type": "text", "id": "title_3", "label": "Title", "default": "3 Pack" },
    { "type": "text", "id": "tag_3", "label": "Tag", "default": "Family Pack" },
    { "type": "range", "id": "save_3", "label": "Save %", "min": 0, "max": 50, "step": 1, "default": 10 },
    { "type": "textarea", "id": "perks_3", "label": "Perks (one per line)" }
  ],
  "presets": [
    {
      "name": "MoonSoon quantity offers"
    }
  ]
}
{% endschema %}
