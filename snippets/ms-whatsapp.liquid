{% doc %}
  MoonSoon floating WhatsApp chat button. Theme settings → MoonSoon WhatsApp button. Hidden without a number.
{% enddoc %}
{%- assign number = settings.ms_wa_number | remove: '+' | remove: ' ' | remove: '-' -%}
{%- if number != blank -%}
  {%- liquid
    assign message = settings.ms_wa_message
    if settings.ms_wa_product_message and template.name == 'product'
      assign message = message | append: ' ' | append: product.title | append: ' ' | append: shop.url | append: product.url
    endif
  -%}
  <a
    class="ms-wa ms-wa--{{ settings.ms_wa_position }}"
    href="https://wa.me/{{ number }}?text={{ message | url_encode }}"
    target="_blank"
    rel="noopener"
    aria-label="WhatsApp: {{ settings.ms_wa_label }}"
  >
    {%- if settings.ms_wa_label != blank -%}
      <span class="ms-wa__label">{{ settings.ms_wa_label }}</span>
    {%- endif -%}
    <span class="ms-wa__icon" aria-hidden="true">
      <svg viewBox="0 0 32 32"><path fill="currentColor" d="M16 3C9 3 3.3 8.6 3.3 15.6c0 2.5.7 4.8 1.9 6.8L3 29l6.8-2.1c1.9 1 4 1.6 6.2 1.6 7 0 12.7-5.7 12.7-12.7S23 3 16 3Zm0 23.2c-2 0-3.9-.6-5.5-1.6l-.4-.2-4 1.2 1.3-3.9-.3-.4a10.3 10.3 0 0 1-1.6-5.6C5.5 9.9 10.2 5.3 16 5.3s10.5 4.6 10.5 10.4S21.8 26.2 16 26.2Zm5.8-7.8c-.3-.2-1.9-.9-2.2-1-.3-.1-.5-.2-.7.2l-1 1.2c-.2.2-.4.2-.7.1a8.6 8.6 0 0 1-4.3-3.7c-.3-.6.3-.5.9-1.7.1-.2 0-.4 0-.5l-1-2.4c-.3-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.5s1.1 2.9 1.2 3.1c.2.2 2.1 3.2 5.1 4.5 1.9.8 2.6.9 3.6.7.6-.1 1.9-.8 2.1-1.5.3-.7.3-1.4.2-1.5-.1-.1-.3-.2-.6-.4Z"/></svg>
    </span>
  </a>
{%- endif -%}
