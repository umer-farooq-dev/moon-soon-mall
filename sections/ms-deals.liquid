{% comment %}
  MoonSoon deals: heading with a rotating word, short text, offer banners (image or gradient + text) and a button.
{% endcomment %}
{%- liquid
  assign words = section.settings.rotating_words | split: ','
  assign words_joined = ''
  for w in words
    assign words_joined = words_joined | append: w | strip | append: '||'
  endfor
-%}
<div class="ms-sec ms-deals" style="--ms-sec-bg: {{ section.settings.background | default: 'var(--ms-pale)' }};">
  <div class="ms-sec__inner">
    {%- if section.settings.eyebrow != blank -%}
      <p class="ms-deals__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    <h2 class="ms-sec__title">
      {{ section.settings.heading }}
      {%- if words.size > 0 -%}
        <span class="ms-deals__word is-in" data-ms-words data-words="{{ words_joined | escape }}">{{ words.first | strip }}</span>
      {%- endif -%}
    </h2>
    {%- if section.settings.text != blank -%}
      <p class="ms-sec__sub ms-deals__text">{{ section.settings.text }}</p>
    {%- endif -%}

    <ul class="ms-deals__grid">
      {%- for block in section.blocks -%}
        {%- assign s = block.settings -%}
        <li {{ block.shopify_attributes }}>
          <a
            href="{{ s.link | default: '#' }}"
            class="ms-offer"
            style="--ms-offer-g1: {{ s.color_1 }}; --ms-offer-g2: {{ s.color_2 }}; --ms-offer-fg: {{ s.text_color }};"
          >
            {%- if s.image != blank -%}
              {{ s.image | image_url: width: 900 | image_tag: class: 'ms-offer__img', loading: 'lazy', alt: '', widths: '450, 700, 900', sizes: '(min-width: 990px) 33vw, 100vw' }}
            {%- endif -%}
            <span class="ms-offer__text">
              {%- if s.small != blank -%}<span>{{ s.small }}</span>{%- endif -%}
              <strong>{{ s.big }}</strong>
              {%- if s.note != blank -%}<span class="ms-offer__note">{{ s.note }}</span>{%- endif -%}
            </span>
            <span class="ms-offer__arrow" aria-hidden="true">{{ 'icon-chevron-right.svg' | inline_asset_content }}</span>
          </a>
        </li>
      {%- endfor -%}
    </ul>

    {%- if section.settings.button_label != blank -%}
      <div class="ms-sec__cta">
        <a class="button" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label }}</a>
      </div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .ms-deals__eyebrow {
    margin: 0 0 8px;
    text-align: center;
    font-size: 15px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .ms-deals__word {
    display: inline-block;
    margin-left: 0.25em;
    color: var(--ms-accent);
  }

  .ms-deals__word.is-in {
    animation: ms-word-in 0.4s ease-out;
  }

  @keyframes ms-word-in {
    from {
      opacity: 0;
      transform: translateY(0.4em);
    }
  }

  .ms-deals__text {
    max-width: 56ch;
    margin-inline: auto;
  }

  .ms-deals__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
    max-width: 1140px;
    margin: 0 auto;
    padding: 0;
    list-style: none;
  }

  .ms-offer {
    position: relative;
    display: flex;
    align-items: center;
    aspect-ratio: var(--ms-offer-ratio, 3.2);
    padding: 16px 18px;
    overflow: hidden;
    border-radius: 18px;
    border: 1px solid var(--ms-shadow-color);
    background: linear-gradient(120deg, var(--ms-offer-g1), var(--ms-offer-g2));
    color: var(--ms-offer-fg);
    text-decoration: none;
    transition: transform 0.15s, box-shadow 0.15s;
  }

  .ms-offer:hover {
    transform: translateY(-2px);
  }

  .ms-offer__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ms-offer__text {
    position: relative;
    display: grid;
    gap: 2px;
    max-width: 75%;
  }

  .ms-offer__text strong {
    font-size: clamp(18px, 1.6vw, 22px);
    line-height: 1.05;
    font-weight: 800;
    text-transform: uppercase;
  }

  .ms-offer__note {
    font-size: 12px;
    font-weight: 700;
  }

  .ms-offer__arrow {
    position: absolute;
    right: 14px;
    bottom: 14px;
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--color-background);
    color: var(--ms-card-title);
  }

  .ms-offer__arrow svg {
    width: 11px;
    height: 11px;
  }

  @media (max-width: 989px) {
    .ms-deals__grid {
      grid-template-columns: 1fr;
      gap: 14px;
    }

    .ms-deals__grid {
      max-width: 520px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "MoonSoon deals",
  "class": "ms-deals-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small label",
      "default": "Big savings"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Hot deals on"
    },
    {
      "type": "text",
      "id": "rotating_words",
      "label": "Rotating words",
      "info": "Comma separated, e.g. Kitchen,Gadgets,Cooling",
      "default": "Kitchen,Gadgets,Cooling"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Limited-time prices on our most useful picks. Grab them before they are gone."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button text",
      "default": "Shop All Deals"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background"
    }
  ],
  "blocks": [
    {
      "type": "offer",
      "name": "Offer banner",
      "settings": [
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Background image",
          "info": "Optional. Recommended 900 × 300 px"
        },
        {
          "type": "text",
          "id": "small",
          "label": "Small text",
          "default": "Shop"
        },
        {
          "type": "text",
          "id": "big",
          "label": "Big text",
          "default": "Under Rs 999"
        },
        {
          "type": "text",
          "id": "note",
          "label": "Note",
          "default": "Budget-friendly picks"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Text color",
          "default": "#FFFFFF"
        },
        {
          "type": "color",
          "id": "color_1",
          "label": "Gradient color 1",
          "default": "#F08A3E"
        },
        {
          "type": "color",
          "id": "color_2",
          "label": "Gradient color 2",
          "default": "#F7B267"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "MoonSoon deals",
      "blocks": [
        { "type": "offer" }
      ]
    }
  ]
}
{% endschema %}
