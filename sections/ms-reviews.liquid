{% comment %}
  MoonSoon review cards slider: photo, stars, date, title, text, name (verified tick), product.
  Add real reviews only. When a reviews app is installed, its own widget can replace this section.
{% endcomment %}
<div class="ms-sec ms-reviews" style="--ms-sec-bg: {{ section.settings.background | default: 'var(--color-background)' }};">
  <div class="ms-sec__inner">
    {%- if section.settings.rating_text != blank -%}
      {%- render 'ms-rating-line', text: section.settings.rating_text -%}
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="ms-sec__title">{{ section.settings.heading }}</h2>
    {%- endif -%}
    <div data-ms-slider>
      <ul class="ms-slider__track ms-reviews__track" data-ms-track>
        {%- for block in section.blocks -%}
          {%- assign s = block.settings -%}
          <li class="ms-slider__slide" {{ block.shopify_attributes }}>
            <article class="ms-review">
              {%- if s.image != blank -%}
                <div class="ms-review__img">
                  {{ s.image | image_url: width: 500 | image_tag: loading: 'lazy', alt: s.title, widths: '250, 375, 500', sizes: '(min-width: 990px) 25vw, 70vw' }}
                </div>
              {%- endif -%}
              <div class="ms-review__body">
                {%- assign pct = s.rating | times: 20 -%}
                <span class="ms-card-rating__stars ms-review__stars" style="--ms-rating: {{ pct }}%;" role="img" aria-label="{{ s.rating }} / 5">
                  <span aria-hidden="true">★★★★★</span>
                  <span class="ms-card-rating__fill" aria-hidden="true">★★★★★</span>
                </span>
                {%- if s.date != blank -%}<p class="ms-review__date">{{ s.date }}</p>{%- endif -%}
                {%- if s.title != blank -%}<p class="ms-review__title">{{ s.title }}</p>{%- endif -%}
                {%- if s.text != blank -%}<p class="ms-review__text">{{ s.text }}</p>{%- endif -%}
                <p class="ms-review__name">
                  {%- if s.verified -%}
                    <svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="9" fill="currentColor"/><path d="m6 10.2 2.6 2.6L14 7.4" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  {%- endif -%}
                  {{ s.name }}
                </p>
                {%- if s.product != blank -%}
                  <a href="{{ s.product.url }}" class="ms-review__product">{{ s.product.title }}</a>
                {%- endif -%}
              </div>
            </article>
          </li>
        {%- endfor -%}
      </ul>
      <div class="ms-slider__nav">
        <div class="ms-slider__progress"><span data-ms-progress></span></div>
        <button type="button" class="ms-round-btn" data-ms-prev aria-label="{{ 'accessibility.slideshow_previous' | t }}">{{ 'icon-chevron-left.svg' | inline_asset_content }}</button>
        <button type="button" class="ms-round-btn" data-ms-next aria-label="{{ 'accessibility.slideshow_next' | t }}">{{ 'icon-chevron-right.svg' | inline_asset_content }}</button>
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  .ms-reviews__track {
    grid-auto-columns: calc((100% - 3 * 20px) / 4);
  }

  .ms-review {
    display: grid;
    align-content: start;
    height: 100%;
    overflow: hidden;
    border: 1.5px solid var(--ms-card-border);
    border-radius: 24px;
    background: var(--color-background);
  }

  .ms-review__img {
    aspect-ratio: 1;
    background: var(--ms-pale);
  }

  .ms-review__img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ms-review__body {
    display: grid;
    justify-items: center;
    gap: 6px;
    padding: 16px;
    text-align: center;
  }

  .ms-review__stars {
    font-size: 17px;
  }

  .ms-review__body p {
    margin: 0;
  }

  .ms-review__date {
    font-size: 12px;
    opacity: 0.7;
  }

  .ms-review__title {
    color: var(--ms-card-title);
    font-weight: 800;
  }

  .ms-review__text {
    font-size: 14px;
    line-height: 1.55;
  }

  .ms-review__name {
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--ms-card-title);
    font-weight: 700;
  }

  .ms-review__name svg {
    width: 16px;
    height: 16px;
    color: var(--ms-shadow-color);
  }

  .ms-review__product {
    color: inherit;
    font-size: 12px;
    opacity: 0.75;
  }

  @media (max-width: 989px) {
    .ms-reviews__track {
      grid-auto-columns: 72%;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "MoonSoon reviews",
  "class": "ms-reviews-section",
  "settings": [
    { "type": "text", "id": "rating_text", "label": "Stars line above heading", "info": "Empty = hidden" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Verified Customer Reviews 🌼" },
    { "type": "color", "id": "background", "label": "Background" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo" },
        { "type": "range", "id": "rating", "label": "Stars", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "text", "id": "date", "label": "Date", "info": "e.g. 12 Oct 2026" },
        { "type": "text", "id": "title", "label": "Title", "default": "Review title" },
        { "type": "textarea", "id": "text", "label": "Review", "default": "Paste a real customer review here." },
        { "type": "text", "id": "name", "label": "Customer name", "default": "Customer name" },
        { "type": "checkbox", "id": "verified", "label": "Verified buyer tick", "default": true },
        { "type": "product", "id": "product", "label": "Product" }
      ]
    }
  ],
  "presets": [
    {
      "name": "MoonSoon reviews",
      "blocks": [{ "type": "review" }, { "type": "review" }, { "type": "review" }, { "type": "review" }]
    }
  ]
}
{% endschema %}
