{% comment %}
  MoonSoon feature cards: image (or icon) + title + text, in a grid.
{% endcomment %}
<div class="ms-sec ms-features" style="--ms-sec-bg: {{ section.settings.background | default: 'var(--ms-pale)' }};">
  <div class="ms-sec__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="ms-sec__title">{{ section.settings.heading }}</h2>
    {%- endif -%}
    <ul class="ms-features__grid" style="--ms-feat-cols: {{ section.settings.columns }};">
      {%- for block in section.blocks -%}
        {%- assign s = block.settings -%}
        <li class="ms-feature" {{ block.shopify_attributes }}>
          <span class="ms-feature__media">
            {%- if s.image != blank -%}
              {{ s.image | image_url: width: 300 | image_tag: loading: 'lazy', alt: s.title }}
            {%- else -%}
              <svg viewBox="0 0 20 20" aria-hidden="true">{%- render 'icon', icon: s.icon -%}</svg>
            {%- endif -%}
          </span>
          <span class="ms-feature__text">
            <strong>{{ s.title }}</strong>
            {%- if s.text != blank -%}<span>{{ s.text }}</span>{%- endif -%}
          </span>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% stylesheet %}
  .ms-features__grid {
    display: grid;
    grid-template-columns: repeat(var(--ms-feat-cols), 1fr);
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ms-feature {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 14px;
    border: 1.5px solid var(--ms-card-border);
    border-radius: 24px;
    background: var(--color-background);
  }

  .ms-feature__media {
    display: grid;
    flex: none;
    place-items: center;
    width: 96px;
    height: 96px;
    overflow: hidden;
    border-radius: 18px;
    background: var(--ms-light);
    color: var(--ms-card-title);
  }

  .ms-feature__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ms-feature__media svg {
    width: 40px;
    height: 40px;
    fill: currentColor;
  }

  .ms-feature__text {
    display: grid;
    gap: 4px;
    font-size: 14px;
    line-height: 1.5;
  }

  .ms-feature__text strong {
    color: var(--ms-card-title);
    font-size: 16px;
  }

  @media (max-width: 989px) {
    .ms-features__grid {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "MoonSoon feature cards",
  "class": "ms-features-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why Shop With MoonSoonMall 💚" },
    { "type": "range", "id": "columns", "label": "Columns (desktop)", "min": 1, "max": 4, "step": 1, "default": 2 },
    { "type": "color", "id": "background", "label": "Background" }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Optional, replaces the icon" },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "truck", "label": "Truck" }, { "value": "return", "label": "Return" }, { "value": "lock", "label": "Lock" },
            { "value": "chat_bubble", "label": "Chat" }, { "value": "price_tag", "label": "Price tag" }, { "value": "box", "label": "Box" },
            { "value": "check_box", "label": "Check" }, { "value": "star", "label": "Star" }, { "value": "heart", "label": "Heart" },
            { "value": "lightning_bolt", "label": "Lightning" }, { "value": "leaf", "label": "Leaf" }, { "value": "snowflake", "label": "Snowflake" }
          ],
          "default": "check_box"
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Feature" },
        { "type": "textarea", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [
    {
      "name": "MoonSoon feature cards",
      "blocks": [{ "type": "feature" }, { "type": "feature" }, { "type": "feature" }, { "type": "feature" }]
    }
  ]
}
{% endschema %}
