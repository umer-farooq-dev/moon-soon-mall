{% comment %}
  MoonSoon video slider: vertical product videos (Shopify-hosted) with a linked product row under each.
  Hidden until at least one block has a video or image.
{% endcomment %}
{%- liquid
  assign has_media = false
  for block in section.blocks
    if block.settings.video != blank or block.settings.video_url != blank or block.settings.image != blank
      assign has_media = true
    endif
  endfor
-%}
{%- if has_media or request.design_mode or section.settings.show_empty -%}
  <div class="ms-sec ms-videos" style="--ms-sec-bg: {{ section.settings.background | default: 'var(--color-background)' }};">
    <div class="ms-sec__inner">
      {%- if section.settings.heading != blank -%}
        <h2 class="ms-sec__title">{{ section.settings.heading }}</h2>
      {%- endif -%}
      <div data-ms-slider>
        <ul class="ms-slider__track ms-videos__track" data-ms-track>
          {%- for block in section.blocks -%}
            {%- assign s = block.settings -%}
            {%- assign p = s.product -%}
            <li class="ms-slider__slide" {{ block.shopify_attributes }}>
              <div class="ms-vcard" data-ms-video>
                {%- liquid
                  assign vid = s.video
                  if vid == blank and s.video_url == blank and p != blank
                    for m in p.media
                      if m.media_type == 'video'
                        assign vid = m
                        break
                      endif
                    endfor
                  endif
                  assign poster = s.image | default: vid.preview_image | default: p.featured_image
                  assign alt_text = p.title | default: s.caption
                  assign has_video = false
                  if vid != blank or s.video_url != blank
                    assign has_video = true
                  endif
                -%}
                <div class="ms-vcard__media{% if has_video == false and s.image == blank %} ms-vcard__media--product{% endif %}">
                  {%- if vid != blank -%}
                    {{ vid | video_tag: loop: true, playsinline: true, preload: 'metadata', image_size: '720x' }}
                  {%- elsif poster != blank -%}
                    {{ poster | image_url: width: 720 | image_tag: loading: 'lazy', alt: alt_text, class: 'ms-vcard__poster' }}
                  {%- else -%}
                    {{ 'image' | placeholder_svg_tag: 'ms-vcard__ph' }}
                  {%- endif -%}
                  {%- if has_video -%}
                    <button
                      type="button"
                      class="ms-vcard__play"
                      data-ms-video-toggle
                      {% if vid == blank %}data-ms-embed="{{ s.video_url | external_video_url: autoplay: true, playsinline: true, rel: 0 }}"{% endif %}
                      aria-label="{{ 'accessibility.play_video' | t }}"
                    >
                      <span>{{ 'icon-play.svg' | inline_asset_content }}</span>
                    </button>
                  {%- endif -%}
                </div>
                {%- if p != blank -%}
                  {%- liquid
                    assign v = p.selected_or_first_available_variant
                    assign r = p.metafields.reviews.rating.value
                    assign rc = p.metafields.reviews.rating_count.value | default: 0
                  -%}
                  <a href="{{ p.url }}" class="ms-vcard__product">
                    {%- if p.featured_image -%}
                      {{ p.featured_image | image_url: width: 120 | image_tag: loading: 'lazy', alt: '' }}
                    {%- endif -%}
                    <span>
                      {%- if rc > 0 or settings.ms_card_show_empty_stars -%}
                        {%- assign pct = r.rating | default: 0 | times: 100.0 | divided_by: 5 -%}
                        <span class="ms-card-rating__stars" style="--ms-rating: {{ pct }}%;" aria-hidden="true">
                          <span>★★★★★</span><span class="ms-card-rating__fill">★★★★★</span>
                        </span>
                        {%- if rc > 0 -%}<small> ({{ rc }})</small>{%- endif -%}
                      {%- endif -%}
                      <strong>{{ p.title }}</strong>
                    </span>
                  </a>
                  {%- if v.available -%}
                    <button type="button" class="button ms-vcard__add" data-ms-add="{{ v.id }}">
                      {{- section.settings.add_label }} | {{ v.price | money_without_trailing_zeros -}}
                    </button>
                  {%- endif -%}
                {%- elsif s.caption != blank -%}
                  <p class="ms-vcard__caption">{{ s.caption }}</p>
                {%- endif -%}
              </div>
            </li>
          {%- endfor -%}
        </ul>
        <div class="ms-slider__nav">
          <div class="ms-slider__progress"><span data-ms-progress></span></div>
          <button type="button" class="ms-round-btn" data-ms-prev aria-label="{{ 'accessibility.slideshow_previous' | t }}">{{ 'icon-chevron-left.svg' | inline_asset_content }}</button>
          <button type="button" class="ms-round-btn" data-ms-next aria-label="{{ 'accessibility.slideshow_next' | t }}">{{ 'icon-chevron-right.svg' | inline_asset_content }}</button>
        </div>
      </div>
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .ms-videos__track {
    grid-auto-columns: calc((100% - 3 * 20px) / 4);
  }

  .ms-vcard {
    display: grid;
    gap: 12px;
    height: 100%;
    padding: 10px 10px 12px;
    border: 1.5px solid var(--ms-shadow-color);
    border-radius: 24px;
    background: var(--ms-pale);
  }

  .ms-vcard__media {
    position: relative;
    aspect-ratio: 9 / 12.5;
    overflow: hidden;
    border: 1px solid var(--ms-card-border);
    border-radius: 18px;
    background: #000;
  }

  .ms-vcard__media--product {
    background: #fff;
  }

  .ms-vcard__media :is(video, img, svg) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ms-vcard__media--product img {
    padding: 14px;
    object-fit: contain;
  }

  .ms-vcard__media iframe {
    width: 100%;
    height: 100%;
    border: 0;
  }

  .ms-vcard__play {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
  }

  .ms-vcard__play span {
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.92);
    color: var(--ms-card-title);
    box-shadow: 0 6px 18px rgb(0 0 0 / 0.2);
    transition: transform 0.15s, opacity 0.2s;
  }

  .ms-vcard__play:hover span {
    transform: scale(1.08);
  }

  .ms-vcard__play svg {
    width: 22px;
    height: 22px;
    margin-left: 3px;
  }

  .ms-vcard__play.is-playing span {
    opacity: 0;
  }

  .ms-vcard__product {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--ms-card-title);
    text-decoration: none;
  }

  .ms-vcard__product img {
    flex: none;
    width: 64px;
    height: 64px;
    padding: 4px;
    object-fit: contain;
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.12);
    border-radius: 10px;
    background: #fff;
  }

  .ms-vcard__product strong {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    font-size: 15px;
    line-height: 1.25;
  }

  .ms-vcard__add {
    width: 100%;
    padding-block: 10px;
    font-size: 14px;
  }

  .ms-vcard__product .ms-card-rating__stars {
    font-size: 13px;
  }

  .ms-vcard__caption {
    margin: 0;
    text-align: center;
    font-weight: 600;
  }

  @media (max-width: 989px) {
    .ms-videos__track {
      grid-auto-columns: 62%;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "MoonSoon video slider",
  "class": "ms-videos-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "See It In Action"
    },
    {
      "type": "text",
      "id": "add_label",
      "label": "Add button text",
      "default": "Add to cart"
    },
    {
      "type": "checkbox",
      "id": "show_empty",
      "label": "Show even without videos",
      "info": "Uses the product photo until a video is added",
      "default": true
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background"
    }
  ],
  "blocks": [
    {
      "type": "video",
      "name": "Video",
      "settings": [
        {
          "type": "video",
          "id": "video",
          "label": "Video",
          "info": "Vertical (9:16) videos look best"
        },
        {
          "type": "video_url",
          "id": "video_url",
          "label": "Or YouTube / Vimeo link",
          "accept": ["youtube", "vimeo"]
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Cover image",
          "info": "Shown before play. Empty = video frame or product photo. No video = product's own video if it has one."
        },
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption (if no product)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "MoonSoon video slider",
      "blocks": [
        { "type": "video" },
        { "type": "video" },
        { "type": "video" },
        { "type": "video" }
      ]
    }
  ]
}
{% endschema %}
