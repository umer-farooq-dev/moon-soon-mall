{% comment %}
  MoonSoon video slider: vertical product videos (Shopify-hosted) with a linked product row under each.
  Hidden until at least one block has a video or image.
{% endcomment %}
{%- liquid
  assign has_media = false
  for block in section.blocks
    if block.settings.video != blank or block.settings.image != blank
      assign has_media = true
    endif
  endfor
-%}
{%- if has_media or request.design_mode -%}
  <div class="ms-sec ms-videos" style="--ms-sec-bg: {{ section.settings.background | default: 'var(--color-background)' }};">
    <div class="ms-sec__inner">
      {%- if section.settings.heading != blank -%}
        <h2 class="ms-sec__title">{{ section.settings.heading }}</h2>
      {%- endif -%}
      <div data-ms-slider>
        <ul class="ms-slider__track ms-videos__track" data-ms-track>
          {%- for block in section.blocks -%}
            {%- assign s = block.settings -%}
            {%- assign p = s.product -%}
            <li class="ms-slider__slide" {{ block.shopify_attributes }}>
              <div class="ms-vcard" data-ms-video>
                <div class="ms-vcard__media">
                  {%- if s.video != blank -%}
                    {{ s.video | video_tag: muted: true, loop: true, playsinline: true, preload: 'metadata', image_size: '600x' }}
                    <button type="button" class="ms-vcard__play" data-ms-video-toggle aria-label="{{ 'accessibility.play_video' | t }}">
                      {{ 'icon-play.svg' | inline_asset_content }}
                    </button>
                  {%- elsif s.image != blank -%}
                    {{ s.image | image_url: width: 600 | image_tag: loading: 'lazy', alt: s.caption }}
                  {%- else -%}
                    {{ 'image' | placeholder_svg_tag: 'ms-vcard__ph' }}
                  {%- endif -%}
                </div>
                {%- if p != blank -%}
                  <a href="{{ p.url }}" class="ms-vcard__product">
                    {%- if p.featured_image -%}
                      {{ p.featured_image | image_url: width: 120 | image_tag: loading: 'lazy', alt: '' }}
                    {%- endif -%}
                    <span>
                      <strong>{{ p.title }}</strong>
                      <span class="ms-vcard__price">{{ p.price | money_without_trailing_zeros }}</span>
                    </span>
                  </a>
                {%- elsif s.caption != blank -%}
                  <p class="ms-vcard__caption">{{ s.caption }}</p>
                {%- endif -%}
              </div>
            </li>
          {%- endfor -%}
        </ul>
        <div class="ms-slider__nav">
          <div class="ms-slider__progress"><span data-ms-progress></span></div>
          <button type="button" class="ms-round-btn" data-ms-prev aria-label="{{ 'accessibility.slideshow_previous' | t }}">{{ 'icon-chevron-left.svg' | inline_asset_content }}</button>
          <button type="button" class="ms-round-btn" data-ms-next aria-label="{{ 'accessibility.slideshow_next' | t }}">{{ 'icon-chevron-right.svg' | inline_asset_content }}</button>
        </div>
      </div>
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .ms-videos__track {
    grid-auto-columns: calc((100% - 3 * 20px) / 4);
  }

  .ms-vcard {
    display: grid;
    gap: 12px;
    padding: 10px;
    border: 1.5px solid var(--ms-card-border);
    border-radius: 24px;
    background: var(--color-background);
  }

  .ms-vcard__media {
    position: relative;
    aspect-ratio: 9 / 13;
    overflow: hidden;
    border-radius: 18px;
    background: var(--ms-pale);
  }

  .ms-vcard__media :is(video, img, svg) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ms-vcard__play {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    border: 0;
    background: transparent;
    cursor: pointer;
  }

  .ms-vcard__play svg {
    width: 58px;
    height: 58px;
    padding: 16px;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.85);
    color: var(--ms-card-title);
  }

  .ms-vcard__play.is-playing svg {
    opacity: 0;
  }

  .ms-vcard__product {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--ms-card-title);
    text-decoration: none;
  }

  .ms-vcard__product img {
    width: 52px;
    height: 52px;
    object-fit: contain;
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.12);
    border-radius: 10px;
    background: #fff;
  }

  .ms-vcard__product strong {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    font-size: 15px;
    line-height: 1.25;
  }

  .ms-vcard__price {
    font-weight: 700;
  }

  .ms-vcard__caption {
    margin: 0;
    text-align: center;
    font-weight: 600;
  }

  @media (max-width: 989px) {
    .ms-videos__track {
      grid-auto-columns: 62%;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "MoonSoon video slider",
  "class": "ms-videos-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "See It In Action"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background"
    }
  ],
  "blocks": [
    {
      "type": "video",
      "name": "Video",
      "settings": [
        {
          "type": "video",
          "id": "video",
          "label": "Video",
          "info": "Vertical (9:16) videos look best"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image (if no video)"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption (if no product)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "MoonSoon video slider",
      "blocks": [
        { "type": "video" },
        { "type": "video" },
        { "type": "video" },
        { "type": "video" }
      ]
    }
  ]
}
{% endschema %}
