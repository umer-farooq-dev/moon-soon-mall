{% comment %}
  MoonSoon logos strip (couriers, payment methods, press): scrolling row of logos.
  A logo without an image shows its name as text.
{% endcomment %}
<div class="ms-logos" style="--ms-logos-bg: {{ section.settings.background | default: 'var(--ms-light)' }}; --ms-logos-h: {{ section.settings.logo_height }}px;">
  {%- if section.settings.heading != blank -%}
    <p class="ms-logos__heading">{{ section.settings.heading }}</p>
  {%- endif -%}
  <div class="ms-logos__viewport">
    <div class="ms-logos__track">
      {%- for i in (1..2) -%}
        <ul class="ms-logos__list"{% if i == 2 %} aria-hidden="true"{% endif %}>
          {%- for n in (1..3) -%}
            {%- for block in section.blocks -%}
              <li {% if i == 1 and n == 1 %}{{ block.shopify_attributes }}{% endif %}>
                {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}"{% if i == 2 or n > 1 %} tabindex="-1"{% endif %}>{%- endif -%}
                {%- if block.settings.image != blank -%}
                  {{ block.settings.image | image_url: height: 120 | image_tag: loading: 'lazy', alt: block.settings.name }}
                {%- else -%}
                  <span class="ms-logos__text">{{ block.settings.name }}</span>
                {%- endif -%}
                {%- if block.settings.link != blank -%}</a>{%- endif -%}
              </li>
            {%- endfor -%}
          {%- endfor -%}
        </ul>
      {%- endfor -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .ms-logos {
    padding: 28px 0;
    background: var(--ms-logos-bg);
    color: var(--ms-card-title);
  }

  .ms-logos__heading {
    margin: 0 0 16px;
    font-weight: 800;
    text-align: center;
  }

  .ms-logos__viewport {
    overflow: hidden;
  }

  .ms-logos__track {
    display: flex;
    width: max-content;
    animation: ms-marquee 40s linear infinite;
  }

  .ms-logos__viewport:hover .ms-logos__track {
    animation-play-state: paused;
  }

  .ms-logos__list {
    display: flex;
    align-items: center;
    gap: 56px;
    margin: 0;
    padding: 0 28px;
    list-style: none;
  }

  .ms-logos__list a {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .ms-logos__list img {
    display: block;
    width: auto;
    height: var(--ms-logos-h);
    object-fit: contain;
  }

  .ms-logos__text {
    font-size: 20px;
    font-weight: 800;
    letter-spacing: 0.02em;
    white-space: nowrap;
    opacity: 0.8;
  }

  @keyframes ms-marquee {
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ms-logos__track {
      animation: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "MoonSoon logos strip",
  "class": "ms-logos-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "range", "id": "logo_height", "label": "Logo height", "min": 20, "max": 80, "step": 2, "unit": "px", "default": 40 },
    { "type": "color", "id": "background", "label": "Background", "info": "Empty = light color from Theme settings" }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Logo image" },
        { "type": "text", "id": "name", "label": "Name", "default": "Logo", "info": "Shown as text when no image" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "MoonSoon logos strip",
      "blocks": [{ "type": "logo" }, { "type": "logo" }, { "type": "logo" }, { "type": "logo" }]
    }
  ]
}
{% endschema %}
