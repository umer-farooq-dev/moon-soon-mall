{% comment %}
  MoonSoon image + text: heading and story on one side, big rounded photo on the other.
  Text falls back to the page content, so About Us is edited in Online Store → Pages.
{% endcomment %}
{%- liquid
  assign s = section.settings
  assign heading = s.heading | default: page.title
  assign body = s.text | default: page.content
-%}
<div class="ms-sec" style="--ms-sec-bg: {{ s.background | default: 'var(--color-background)' }};">
  <div class="ms-sec__inner ms-about ms-about--{{ s.image_position }}">
    <div class="ms-about__text">
      {%- if s.eyebrow != blank -%}<p class="ms-about__eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
      <h1 class="ms-about__title">{{ heading }}</h1>
      <div class="ms-about__body rte">{{ body }}</div>
      {%- if s.button_label != blank -%}
        <a class="button" href="{{ s.button_link | default: routes.all_products_collection_url }}">{{ s.button_label }}</a>
      {%- endif -%}
    </div>
    <div class="ms-about__media">
      {%- if s.image != blank -%}
        {{ s.image | image_url: width: 1200 | image_tag: loading: 'eager', alt: heading, widths: '600, 900, 1200', sizes: '(min-width: 990px) 48vw, 100vw' }}
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'ms-ph' }}
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "MoonSoon image + text",
  "class": "ms-about-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small label" },
    { "type": "text", "id": "heading", "label": "Heading", "info": "Empty = page title" },
    { "type": "richtext", "id": "text", "label": "Text", "info": "Empty = page content (Online Store → Pages)" },
    { "type": "text", "id": "button_label", "label": "Button text" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Recommended 1200 × 1100 px" },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        { "value": "right", "label": "Right" },
        { "value": "left", "label": "Left" }
      ],
      "default": "right"
    },
    { "type": "color", "id": "background", "label": "Background" }
  ],
  "presets": [
    {
      "name": "MoonSoon image + text"
    }
  ]
}
{% endschema %}
