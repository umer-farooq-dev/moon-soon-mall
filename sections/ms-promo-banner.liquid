{% comment %}
  MoonSoon promo banner: gradient (or image) panel with heading, text and button; optional image on the side.
{% endcomment %}
{%- assign s = section.settings -%}
<div class="ms-sec ms-pbanner-wrap" style="--ms-sec-bg: {{ s.background | default: 'var(--color-background)' }};">
  <div class="ms-sec__inner">
    <div
      class="ms-pbanner ms-pbanner--{{ s.image_position }}"
      style="--ms-pb-g1: {{ s.color_1 }}; --ms-pb-g2: {{ s.color_2 }}; --ms-pb-fg: {{ s.text_color }};"
    >
      <div class="ms-pbanner__text">
        {%- if s.heading != blank -%}<h2 class="ms-pbanner__title">{{ s.heading }}</h2>{%- endif -%}
        {%- if s.text != blank -%}<div class="ms-pbanner__desc">{{ s.text }}</div>{%- endif -%}
        {%- if s.button_label != blank -%}
          <a class="button ms-pbanner__btn" href="{{ s.button_link | default: '#' }}">{{ s.button_label }}</a>
        {%- endif -%}
      </div>
      <div class="ms-pbanner__media">
        {%- if s.image != blank -%}
          {{ s.image | image_url: width: 1000 | image_tag: loading: 'lazy', alt: s.heading, widths: '500, 750, 1000', sizes: '(min-width: 750px) 50vw, 100vw' }}
        {%- elsif request.design_mode -%}
          {{ 'lifestyle-2' | placeholder_svg_tag: 'ms-ph' }}
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  .ms-pbanner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    min-height: 380px;
    overflow: hidden;
    border: 1.5px solid var(--ms-shadow-color);
    border-radius: 28px;
    background: linear-gradient(135deg, var(--ms-pb-g1), var(--ms-pb-g2));
    color: var(--ms-pb-fg);
  }

  .ms-pbanner--left .ms-pbanner__media {
    order: -1;
  }

  .ms-pbanner__text {
    display: grid;
    justify-items: start;
    gap: 14px;
    padding: clamp(24px, 4vw, 56px);
  }

  .ms-pbanner__title {
    margin: 0;
    color: inherit;
    font-size: clamp(26px, 3vw, 42px);
    line-height: 1.1;
    font-weight: 800;
  }

  .ms-pbanner__desc {
    max-width: 46ch;
    font-size: 16px;
    line-height: 1.6;
  }

  .ms-pbanner__desc p {
    margin: 0;
  }

  .ms-pbanner__media {
    align-self: stretch;
  }

  .ms-pbanner__media :is(img, svg) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ms-pbanner__media:empty {
    display: none;
  }

  .ms-pbanner:has(.ms-pbanner__media:empty) {
    grid-template-columns: 1fr;
    text-align: center;
  }

  .ms-pbanner:has(.ms-pbanner__media:empty) .ms-pbanner__text {
    justify-items: center;
  }

  @media (max-width: 749px) {
    .ms-pbanner {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .ms-pbanner__text {
      justify-items: center;
    }

    .ms-pbanner .ms-pbanner__media {
      order: 2;
      max-height: 320px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "MoonSoon promo banner",
  "class": "ms-pbanner-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Not Sure What To Buy? 🎁" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Tell us who it's for and your budget. Our team will suggest the perfect useful gift for your home, family or friends.</p>" },
    { "type": "text", "id": "button_label", "label": "Button text", "default": "Shop Gifts" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Recommended 1000 × 800 px" },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        { "value": "right", "label": "Right" },
        { "value": "left", "label": "Left" }
      ],
      "default": "right"
    },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#FFFFFF" },
    { "type": "color", "id": "color_1", "label": "Gradient color 1", "default": "#1F6B45" },
    { "type": "color", "id": "color_2", "label": "Gradient color 2", "default": "#7BC9A0" },
    { "type": "color", "id": "background", "label": "Section background" }
  ],
  "presets": [
    {
      "name": "MoonSoon promo banner"
    }
  ]
}
{% endschema %}
