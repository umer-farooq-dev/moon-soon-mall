{% comment %}
  MoonSoon: scrolling announcement bar (marquee). Each block is one message.
{% endcomment %}
{%- liquid
  assign speed = section.settings.speed | default: 40
-%}
{%- if section.blocks.size > 0 -%}
  <div
    class="ms-ann"
    style="--ms-ann-bg: {{ section.settings.background }}; --ms-ann-fg: {{ section.settings.text_color }}; --ms-ann-speed: {{ speed }}s;"
  >
    <div class="ms-ann__track{% if section.settings.pause_on_hover %} ms-ann__track--pause{% endif %}">
      {%- comment -%} Two identical halves make the loop seamless; each half repeats the messages so short lists still fill wide screens {%- endcomment -%}
      {%- for half in (1..2) -%}
        <ul class="ms-ann__list">
          {%- for r in (1..3) -%}
            {%- liquid
              assign is_first = false
              if half == 1 and r == 1
                assign is_first = true
              endif
            -%}
            {%- for block in section.blocks -%}
              <li class="ms-ann__item" {% if is_first %}{{ block.shopify_attributes }}{% else %}aria-hidden="true"{% endif %}>
                {{ block.settings.text }}
                {%- if block.settings.link != blank and block.settings.link_label != blank -%}
                  <a href="{{ block.settings.link }}" {% unless is_first %}tabindex="-1"{% endunless %}>{{ block.settings.link_label }}</a>
                {%- endif -%}
              </li>
            {%- endfor -%}
          {%- endfor -%}
        </ul>
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  :root {
    --ms-ann-h: 0px;
  }

  :root:has(.ms-ann) {
    --ms-ann-h: 40px;
  }

  .ms-ann {
    height: var(--ms-ann-h);
    overflow: hidden;
    background: var(--ms-ann-bg);
    color: var(--ms-ann-fg);
    display: flex;
    align-items: center;
  }

  .ms-ann__track {
    display: flex;
    width: max-content;
    animation: ms-ann-scroll var(--ms-ann-speed) linear infinite;
  }

  .ms-ann__track--pause:hover {
    animation-play-state: paused;
  }

  .ms-ann__list {
    display: flex;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ms-ann__item {
    display: flex;
    align-items: center;
    gap: 6px;
    white-space: nowrap;
    font-size: 14px;
    font-weight: 800;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    padding-inline: 14px;
  }

  .ms-ann__item::after {
    content: '';
    width: 1px;
    height: 18px;
    margin-left: 28px;
    background: currentColor;
    opacity: 0.6;
  }

  .ms-ann__item a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @keyframes ms-ann-scroll {
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ms-ann__track {
      animation: none;
    }
  }

  @media (max-width: 749px) {
    :root:has(.ms-ann) {
      --ms-ann-h: 34px;
    }

    .ms-ann__item {
      font-size: 12px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "MoonSoon announcement",
  "tag": "div",
  "class": "ms-ann-section",
  "settings": [
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#2E8B57"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Scroll time (higher = slower)",
      "min": 10,
      "max": 120,
      "step": 5,
      "unit": "s",
      "default": 40
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause on hover",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Cash on delivery all over Pakistan"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link text",
          "info": "Shown underlined after the message, e.g. SHOP NOW"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "MoonSoon announcement",
      "blocks": [
        { "type": "message" }
      ]
    }
  ]
}
{% endschema %}
