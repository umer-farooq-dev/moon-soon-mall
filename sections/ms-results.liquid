{% comment %}
  MoonSoon results slider: real customer / in-use photos (one image or before + after), name, badge, quote.
{% endcomment %}
<div class="ms-sec ms-results" style="--ms-sec-bg: {{ section.settings.background | default: 'var(--ms-pale)' }};">
  <div class="ms-sec__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="ms-sec__title">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <p class="ms-sec__sub">{{ section.settings.subheading }}</p>
    {%- endif -%}
    <div data-ms-slider>
      <ul class="ms-slider__track ms-results__track" data-ms-track>
        {%- for block in section.blocks -%}
          {%- assign s = block.settings -%}
          <li class="ms-slider__slide" {{ block.shopify_attributes }}>
            <div class="ms-result">
              <div class="ms-result__media{% if s.image_2 != blank %} ms-result__media--split{% endif %}">
                {%- if s.image != blank -%}
                  <figure>
                    {{ s.image | image_url: width: 600 | image_tag: loading: 'lazy', alt: s.name, widths: '300, 450, 600', sizes: '(min-width: 990px) 25vw, 70vw' }}
                    {%- if s.label_1 != blank and s.image_2 != blank -%}<figcaption>{{ s.label_1 }}</figcaption>{%- endif -%}
                  </figure>
                {%- else -%}
                  <figure>{{ 'lifestyle-1' | placeholder_svg_tag: 'ms-ph' }}</figure>
                {%- endif -%}
                {%- if s.image_2 != blank -%}
                  <figure>
                    {{ s.image_2 | image_url: width: 600 | image_tag: loading: 'lazy', alt: s.name, widths: '300, 450, 600', sizes: '(min-width: 990px) 25vw, 70vw' }}
                    {%- if s.label_2 != blank -%}<figcaption>{{ s.label_2 }}</figcaption>{%- endif -%}
                  </figure>
                {%- endif -%}
              </div>
              <div class="ms-result__body">
                <p class="ms-result__head">
                  <strong>{{ s.name }}</strong>
                  {%- if s.badge != blank -%}<span>{{ s.badge }}</span>{%- endif -%}
                </p>
                {%- if s.quote != blank -%}<p class="ms-result__quote">{{ s.quote }}</p>{%- endif -%}
                {%- if s.product != blank -%}
                  <a href="{{ s.product.url }}" class="ms-result__product">{{ s.product.title }} →</a>
                {%- endif -%}
              </div>
            </div>
          </li>
        {%- endfor -%}
      </ul>
      <div class="ms-slider__nav">
        <div class="ms-slider__progress"><span data-ms-progress></span></div>
        <button type="button" class="ms-round-btn" data-ms-prev aria-label="{{ 'accessibility.slideshow_previous' | t }}">{{ 'icon-chevron-left.svg' | inline_asset_content }}</button>
        <button type="button" class="ms-round-btn" data-ms-next aria-label="{{ 'accessibility.slideshow_next' | t }}">{{ 'icon-chevron-right.svg' | inline_asset_content }}</button>
      </div>
    </div>
    {%- if section.settings.button_label != blank -%}
      <div class="ms-sec__cta">
        <a class="button" href="{{ section.settings.button_link | default: '#' }}">{{ section.settings.button_label }}</a>
      </div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .ms-results__track {
    grid-auto-columns: calc((100% - 3 * 20px) / 4);
  }

  .ms-result {
    display: grid;
    height: 100%;
    overflow: hidden;
    border: 1.5px solid var(--ms-card-border);
    border-radius: 24px;
    background: var(--color-background);
  }

  .ms-result__media {
    display: grid;
    aspect-ratio: 1;
    background: var(--ms-pale);
  }

  .ms-result__media--split {
    grid-template-columns: 1fr 1fr;
  }

  .ms-result__media figure {
    position: relative;
    margin: 0;
    overflow: hidden;
  }

  .ms-result__media :is(img, svg) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ms-result__media figcaption {
    position: absolute;
    left: 50%;
    bottom: 8px;
    padding: 2px 10px;
    border-radius: 62px;
    background: rgb(0 0 0 / 0.45);
    color: #fff;
    font-size: 12px;
    font-weight: 700;
    transform: translateX(-50%);
  }

  .ms-result__body {
    display: grid;
    align-content: start;
    gap: 8px;
    padding: 14px 16px 18px;
  }

  .ms-result__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin: 0;
    color: var(--ms-card-title);
  }

  .ms-result__head span {
    padding: 3px 10px;
    border-radius: 62px;
    background: var(--ms-shadow-color);
    color: #fff;
    font-size: 12px;
    font-weight: 700;
    white-space: nowrap;
  }

  .ms-result__quote {
    margin: 0;
    font-size: 14px;
    line-height: 1.55;
  }

  .ms-result__product {
    color: var(--ms-card-title);
    font-size: 13px;
    font-weight: 700;
  }

  @media (max-width: 989px) {
    .ms-results__track {
      grid-auto-columns: 72%;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "MoonSoon results",
  "class": "ms-results-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Results You Can See 💚" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Real customers. Real products. No filters." },
    { "type": "text", "id": "button_label", "label": "Button text", "default": "Read All Reviews" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "color", "id": "background", "label": "Background" }
  ],
  "blocks": [
    {
      "type": "result",
      "name": "Result",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo (or Before photo)" },
        { "type": "text", "id": "label_1", "label": "Label on photo 1", "default": "Before" },
        { "type": "image_picker", "id": "image_2", "label": "After photo (optional)" },
        { "type": "text", "id": "label_2", "label": "Label on photo 2", "default": "After" },
        { "type": "text", "id": "name", "label": "Customer name", "default": "Customer name" },
        { "type": "text", "id": "badge", "label": "Badge", "default": "Verified" },
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "Write what the customer said about the product here." },
        { "type": "product", "id": "product", "label": "Product" }
      ]
    }
  ],
  "presets": [
    {
      "name": "MoonSoon results",
      "blocks": [{ "type": "result" }, { "type": "result" }, { "type": "result" }, { "type": "result" }]
    }
  ]
}
{% endschema %}
