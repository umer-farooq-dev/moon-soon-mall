{% comment %}
  MoonSoon hero: slides with separate desktop/mobile images. Without images a slide shows a gradient with text.
{% endcomment %}
<div
  class="ms-hero"
  data-ms-hero
  data-autoplay="{% if section.settings.autoplay %}{{ section.settings.speed }}{% else %}0{% endif %}"
  style="--ms-hero-h: {{ section.settings.height }}px; --ms-hero-h-m: {{ section.settings.height_mobile }}px;"
>
  {%- for block in section.blocks -%}
    {%- assign s = block.settings -%}
    {%- assign has_img = false -%}
    {%- if s.image != blank or s.image_mobile != blank -%}{%- assign has_img = true -%}{%- endif -%}
    <div
      class="ms-hero__slide{% if forloop.first %} is-active{% endif %}{% unless has_img %} ms-hero__slide--text{% endunless %}"
      data-ms-slide
      style="--ms-hero-g1: {{ s.color_1 }}; --ms-hero-g2: {{ s.color_2 }}; --ms-hero-fg: {{ s.text_color }};"
      {{ block.shopify_attributes }}
    >
      {%- if s.link != blank -%}<a href="{{ s.link }}" class="ms-hero__link" aria-label="{{ s.heading | default: s.button | escape }}"></a>{%- endif -%}

      {%- if has_img -%}
        {%- assign desk = s.image | default: s.image_mobile -%}
        {%- assign mob = s.image_mobile | default: s.image -%}
        {%- assign loading = 'lazy' -%}{%- assign prio = 'auto' -%}
        {%- if forloop.first -%}{%- assign loading = 'eager' -%}{%- assign prio = 'high' -%}{%- endif -%}
        <picture>
          <source media="(max-width: 749px)" srcset="{{ mob | image_url: width: 750 }} 750w, {{ mob | image_url: width: 1100 }} 1100w" sizes="100vw">
          {{
            desk
            | image_url: width: 2400
            | image_tag:
              class: 'ms-hero__img',
              widths: '1000, 1500, 2000, 2400',
              sizes: '100vw',
              alt: s.heading,
              loading: loading,
              fetchpriority: prio
          }}
        </picture>
      {%- endif -%}

      {%- if s.heading != blank or s.text != blank or s.button != blank -%}
        <div class="ms-hero__content ms-hero__content--{{ s.align }}">
          {%- if s.eyebrow != blank -%}<span class="ms-hero__eyebrow">{{ s.eyebrow }}</span>{%- endif -%}
          {%- if s.heading != blank -%}<h2 class="ms-hero__heading">{{ s.heading }}</h2>{%- endif -%}
          {%- if s.text != blank -%}<p class="ms-hero__text">{{ s.text }}</p>{%- endif -%}
          {%- if s.button != blank -%}<span class="button ms-hero__btn">{{ s.button }}</span>{%- endif -%}
        </div>
      {%- endif -%}
    </div>
  {%- endfor -%}

  {%- if section.blocks.size > 1 -%}
    <button type="button" class="ms-round-btn ms-hero__arrow ms-hero__arrow--prev" data-ms-prev aria-label="{{ 'accessibility.slideshow_previous' | t }}">{{ 'icon-chevron-left.svg' | inline_asset_content }}</button>
    <button type="button" class="ms-round-btn ms-hero__arrow ms-hero__arrow--next" data-ms-next aria-label="{{ 'accessibility.slideshow_next' | t }}">{{ 'icon-chevron-right.svg' | inline_asset_content }}</button>
    <div class="ms-hero__dots">
      {%- for block in section.blocks -%}
        <button type="button" data-ms-dot aria-current="{% if forloop.first %}true{% else %}false{% endif %}" aria-label="{{ forloop.index }}"></button>
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>

{% stylesheet %}
  .ms-hero {
    position: relative;
    height: var(--ms-hero-h);
    overflow: hidden;
  }

  .ms-hero__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.6s, visibility 0s 0.6s;
    background: linear-gradient(120deg, var(--ms-hero-g1), var(--ms-hero-g2));
    color: var(--ms-hero-fg);
  }

  .ms-hero__slide.is-active {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.6s;
  }

  .ms-hero__link {
    position: absolute;
    inset: 0;
    z-index: 2;
  }

  .ms-hero__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ms-hero__content {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 14px;
    max-width: var(--page-width, 1440px);
    margin-inline: auto;
    padding: 40px var(--page-margin, 40px);
    pointer-events: none;
  }

  .ms-hero__content--center {
    align-items: center;
    text-align: center;
  }

  .ms-hero__content--left {
    align-items: flex-start;
  }

  .ms-hero__eyebrow {
    display: inline-block;
    padding: 6px 14px;
    border-radius: 6px;
    background: var(--ms-highlight);
    color: var(--ms-card-title);
    font-size: clamp(16px, 2vw, 26px);
    font-style: italic;
    font-weight: 700;
  }

  .ms-hero__heading {
    margin: 0;
    max-width: 16ch;
    font-size: clamp(34px, 5.2vw, 76px);
    line-height: 1.02;
    font-weight: 800;
    color: inherit;
  }

  .ms-hero__text {
    margin: 0;
    max-width: 42ch;
    font-size: clamp(15px, 1.4vw, 20px);
  }

  .ms-hero__btn {
    margin-top: 6px;
    pointer-events: auto;
  }

  .ms-hero__arrow {
    position: absolute;
    top: 50%;
    z-index: 3;
    transform: translateY(-50%);
  }

  .ms-hero__arrow--prev {
    left: 18px;
  }

  .ms-hero__arrow--next {
    right: 18px;
  }

  .ms-hero__dots {
    position: absolute;
    left: 50%;
    bottom: 16px;
    z-index: 3;
    display: flex;
    gap: 8px;
    transform: translateX(-50%);
  }

  .ms-hero__dots button {
    width: 10px;
    height: 10px;
    padding: 0;
    border: 1.5px solid #fff;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.4);
    cursor: pointer;
    transition: width 0.2s;
  }

  .ms-hero__dots button[aria-current='true'] {
    width: 28px;
    background: #fff;
  }

  @media (max-width: 749px) {
    .ms-hero {
      height: var(--ms-hero-h-m);
    }

    .ms-hero__arrow {
      display: none;
    }

    .ms-hero__content {
      padding: 28px 18px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "MoonSoon hero",
  "class": "ms-hero-section",
  "settings": [
    {
      "type": "range",
      "id": "height",
      "label": "Height (desktop)",
      "min": 300,
      "max": 900,
      "step": 10,
      "unit": "px",
      "default": 590
    },
    {
      "type": "range",
      "id": "height_mobile",
      "label": "Height (mobile)",
      "min": 300,
      "max": 900,
      "step": 10,
      "unit": "px",
      "default": 600
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Auto-rotate slides",
      "default": true
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Seconds per slide",
      "min": 3,
      "max": 12,
      "step": 1,
      "unit": "s",
      "default": 5
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Desktop image",
          "info": "Recommended 2400 × 1000 px"
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "Mobile image",
          "info": "Recommended 1100 × 1400 px"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "header",
          "content": "Text (optional, shown over the image)"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Small label"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "text",
          "id": "button",
          "label": "Button text"
        },
        {
          "type": "select",
          "id": "align",
          "label": "Text position",
          "options": [
            { "value": "left", "label": "Left" },
            { "value": "center", "label": "Center" }
          ],
          "default": "left"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Text color",
          "default": "#FFFFFF"
        },
        {
          "type": "color",
          "id": "color_1",
          "label": "Background color 1 (no image)",
          "default": "#2E8B57"
        },
        {
          "type": "color",
          "id": "color_2",
          "label": "Background color 2 (no image)",
          "default": "#7BC9A0"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "MoonSoon hero",
      "blocks": [
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}
