{% comment %}
  MoonSoon collection banner: text on the left, image (or a collage of the first products) on the right.
{% endcomment %}
{%- liquid
  assign c = collection | default: section.settings.collection
  assign title = section.settings.heading | default: c.title | default: page.title
  assign text = section.settings.text | default: c.description
  assign banner_image = section.settings.image
  if banner_image == blank and section.settings.use_collection_image and c.image != blank
    assign banner_image = c.image
  endif
  assign has_media = false
  if section.settings.show_media
    if banner_image != blank or c != blank
      assign has_media = true
    endif
  endif
-%}
<div
  class="ms-cbanner-wrap"
  style="--ms-cb-g1: {{ section.settings.color_1 }}; --ms-cb-g2: {{ section.settings.color_2 }}; --ms-cb-fg: {{ section.settings.text_color }};"
>
  <div class="ms-cbanner">
    <div class="ms-cbanner__text">
      {%- if section.settings.show_breadcrumb -%}
        <nav class="ms-cbanner__crumbs">
          <a href="{{ routes.root_url }}">{{ section.settings.home_label }}</a>
          <span aria-hidden="true">/</span>
          <span>{{ title }}</span>
        </nav>
      {%- endif -%}
      <h1 class="ms-cbanner__title">{{ title }}</h1>
      {%- if text != blank -%}
        <div class="ms-cbanner__desc">{{ text | strip_html | truncatewords: section.settings.words }}</div>
      {%- endif -%}
      {%- if section.settings.show_count and c != blank and template.name == 'collection' -%}
        <p class="ms-cbanner__count">{{ section.settings.count_text | replace: '[count]', c.products_count }}</p>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a class="button ms-cbanner__btn" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
          {{- section.settings.button_label -}}
        </a>
      {%- endif -%}
    </div>

    {%- if has_media -%}
      <div class="ms-cbanner__media">
        {%- if banner_image != blank -%}
          {{ banner_image | image_url: width: 1000 | image_tag: class: 'ms-cbanner__img', loading: 'eager', alt: title, widths: '500, 750, 1000', sizes: '(min-width: 750px) 45vw, 100vw' }}
        {%- elsif c != blank -%}
          <ul class="ms-cbanner__collage">
            {%- for p in c.products limit: 4 -%}
              {%- if p.featured_image -%}
                <li style="--i: {{ forloop.index0 }};">
                  {{ p.featured_image | image_url: width: 400 | image_tag: loading: 'eager', alt: '', widths: '200, 300, 400', sizes: '(min-width: 750px) 18vw, 40vw' }}
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .ms-cbanner-wrap {
    padding: 20px var(--page-margin, 16px) 4px;
  }

  .ms-cbanner {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    align-items: center;
    gap: 24px;
    max-width: var(--page-width, 1400px);
    margin-inline: auto;
    padding: clamp(22px, 3vw, 40px);
    overflow: hidden;
    border: 1.5px solid var(--ms-shadow-color);
    border-radius: 28px;
    background: linear-gradient(120deg, var(--ms-cb-g1), var(--ms-cb-g2));
    color: var(--ms-cb-fg);
    box-shadow: var(--ms-btn-depth) var(--ms-btn-depth) 0 0 var(--ms-shadow-color);
  }

  .ms-cbanner:not(:has(.ms-cbanner__media)) {
    grid-template-columns: 1fr;
    text-align: center;
  }

  .ms-cbanner__crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 10px;
    font-size: 13px;
    opacity: 0.85;
  }

  .ms-cbanner:not(:has(.ms-cbanner__media)) .ms-cbanner__crumbs {
    justify-content: center;
  }

  .ms-cbanner__crumbs a {
    color: inherit;
  }

  .ms-cbanner__title {
    margin: 0 0 10px;
    color: inherit;
    font-size: clamp(26px, 3.2vw, 44px);
    line-height: 1.1;
    font-weight: 800;
  }

  .ms-cbanner__desc {
    max-width: 52ch;
    margin-bottom: 12px;
    font-size: 15px;
    line-height: 1.55;
  }

  .ms-cbanner:not(:has(.ms-cbanner__media)) .ms-cbanner__desc {
    margin-inline: auto;
  }

  .ms-cbanner__count {
    display: inline-block;
    margin: 0 0 14px;
    padding: 4px 12px;
    border-radius: 62px;
    background: var(--ms-highlight);
    color: var(--ms-card-title);
    font-size: 13px;
    font-weight: 700;
  }

  .ms-cbanner__btn {
    display: table;
  }

  .ms-cbanner:not(:has(.ms-cbanner__media)) .ms-cbanner__btn {
    margin-inline: auto;
  }

  .ms-cbanner__img {
    display: block;
    width: 100%;
    height: auto;
    max-height: 340px;
    object-fit: contain;
    border-radius: 20px;
  }

  .ms-cbanner__collage {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ms-cbanner__collage li {
    aspect-ratio: 1;
    padding: 8px;
    border: 1.5px solid var(--ms-shadow-color);
    border-radius: 18px;
    background: #fff;
    transform: rotate(calc((var(--i) - 1.5) * 1.5deg));
  }

  .ms-cbanner__collage img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  @media (min-width: 750px) {
    .ms-cbanner__collage {
      grid-template-columns: repeat(4, 1fr);
    }

    .ms-cbanner__collage li:nth-child(even) {
      margin-top: 28px;
    }
  }

  @media (max-width: 749px) {
    .ms-cbanner {
      grid-template-columns: 1fr;
      border-radius: 22px;
    }

    .ms-cbanner__media {
      order: -1;
    }

    .ms-cbanner__collage {
      grid-template-columns: repeat(4, 1fr);
      gap: 8px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "MoonSoon page banner",
  "class": "ms-cbanner-section",
  "enabled_on": {
    "templates": ["collection", "list-collections", "page"]
  },
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Only used outside collection pages"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Empty = collection name"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "info": "Empty = collection description"
    },
    {
      "type": "range",
      "id": "words",
      "label": "Max words of description",
      "min": 10,
      "max": 80,
      "step": 5,
      "default": 35
    },
    {
      "type": "checkbox",
      "id": "show_breadcrumb",
      "label": "Show breadcrumb",
      "default": true
    },
    {
      "type": "text",
      "id": "home_label",
      "label": "Breadcrumb home text",
      "default": "Home"
    },
    {
      "type": "checkbox",
      "id": "show_count",
      "label": "Show product count",
      "default": true
    },
    {
      "type": "text",
      "id": "count_text",
      "label": "Product count text",
      "default": "[count] products",
      "info": "[count] = number of products"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button text"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "checkbox",
      "id": "show_media",
      "label": "Show image area",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Banner image",
      "info": "Empty = collection image, or a collage of its first 4 products"
    },
    {
      "type": "checkbox",
      "id": "use_collection_image",
      "label": "Use collection image when set",
      "default": false
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#1F6B45"
    },
    {
      "type": "color",
      "id": "color_1",
      "label": "Gradient color 1",
      "default": "#D6F1E1"
    },
    {
      "type": "color",
      "id": "color_2",
      "label": "Gradient color 2",
      "default": "#EEF8F2"
    }
  ],
  "presets": [
    {
      "name": "MoonSoon page banner"
    }
  ]
}
{% endschema %}
